# Get a free key at https://aistudio.google.com/apikey (needed from milestone 2)
GEMINI_API_KEY=

# More Gemini keys (used when one runs out of quota): GEMINI_API_KEY_2=..., GEMINI_API_KEY_3=...

# Optional. With a key set, a provider is also used as a fallback when the main one fails (configs/llm.yaml)
# NVIDIA_API_KEY=
# OPENROUTER_API_KEY=
# GROQ_API_KEY=
